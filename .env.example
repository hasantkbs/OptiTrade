# ──────────────────────────────────────────────────────────────────────────────
# OptiTrade — docker-compose variable interpolation
#
# docker-compose.yml reads this file (project-root .env, next to
# docker-compose.yml) to fill in ${FEATURE_STORE_POSTGRES_*} for the
# `postgres` and `api` services. It is separate from backend/.env, which
# the `api` container also loads (via `env_file:`) for every other
# backend setting — see backend/.env.example for the full list.
#
# Copy this file to .env at the repo root and fill in real values.
# NEVER commit the actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# Must match backend/.env's FEATURE_STORE_POSTGRES_* — both the `api`
# container's application code and docker-compose's `postgres` service
# need the same database name/credentials.
FEATURE_STORE_POSTGRES_DB=optitrade
FEATURE_STORE_POSTGRES_USER=optitrade_user
FEATURE_STORE_POSTGRES_PASSWORD=

# ── Public domain (SERVER STEP 5) ─────────────────────────────────────────────
# The real, DNS-resolvable domain this API will be served from, e.g.
# api.example.com. Used by the `proxy` (nginx) service's server_name and
# TLS certificate paths, and as the -d argument to certbot when issuing
# the certificate - see docs/deployment/https-reverse-proxy.md for the
# full procedure. NOT a placeholder value the app can start "securely"
# with: until this is a real domain with DNS pointed at this host and a
# certificate actually issued for it, `proxy` will not serve HTTPS.
# Defaults to "localhost" (docker-compose.yml) only so unrelated local
# `docker compose up api postgres` commands don't fail to interpolate -
# that default is never usable for a real deployment.
DOMAIN=
