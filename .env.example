# ──────────────────────────────────────────────────────────────────────────────
# OptiTrade — docker-compose variable interpolation
#
# docker-compose.yml reads this file (project-root .env, next to
# docker-compose.yml) to fill in ${FEATURE_STORE_POSTGRES_*} for the
# `postgres` and `api` services. It is separate from backend/.env, which
# the `api` container also loads (via `env_file:`) for every other
# backend setting — see backend/.env.example for the full list.
#
# Copy this file to .env at the repo root and fill in real values.
# NEVER commit the actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# Must match backend/.env's FEATURE_STORE_POSTGRES_* — both the `api`
# container's application code and docker-compose's `postgres` service
# need the same database name/credentials.
FEATURE_STORE_POSTGRES_DB=optitrade
FEATURE_STORE_POSTGRES_USER=optitrade_user
FEATURE_STORE_POSTGRES_PASSWORD=
