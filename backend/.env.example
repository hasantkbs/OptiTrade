# ──────────────────────────────────────────────────────────────────────────────
# OptiTrade Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
DEBUG=False
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
APP_VERSION=4.0.0

# Set to exactly "production" on a real deployment. This is the ONE
# thing that currently changes behavior: with ENVIRONMENT=production,
# startup refuses to run (main.py::_validate_production_config, SERVER
# STEP 3) unless USERS_JWT_SECRET below is actually set. Left unset
# (the default), local development is unaffected.
ENVIRONMENT=development

# ── Firebase Auth ─────────────────────────────────────────────────────────────
# Path to the service-account JSON downloaded from Firebase console.
# Never commit this file — it is listed in .gitignore.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (in addition to defaults).
# Example: https://my-frontend.web.app,https://app.optitrade.io
ALLOWED_ORIGINS=

# ── Data Providers ────────────────────────────────────────────────────────────
# NewsAPI — https://newsapi.org/
NEWS_API_KEY=

# Reddit API — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=optitrade:v1.0 (by /u/your_username)

# Binance — public klines/ticker endpoints used by providers/binance_provider.py
# need NO key. These are only for future authenticated Binance features.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Finnhub — https://finnhub.io/dashboard (free tier: 60 calls/min)
# Used by providers/finnhub_provider.py for US-listed symbols under
# MARKET_DATA_PROVIDER=HYBRID. If unset, HybridProvider falls back to
# yfinance for US symbols automatically — nothing breaks without a key.
FINNHUB_API_KEY=

# ── LLM Providers (Phase 4) ───────────────────────────────────────────────────
# Primary LLM — Anthropic Claude
ANTHROPIC_API_KEY=

# Fallback LLM — OpenAI GPT
OPENAI_API_KEY=

# ── Database (Phase 3) ────────────────────────────────────────────────────────
# PostgreSQL connection string (with TimescaleDB extension).
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://optitrade:optitrade@localhost:5432/optitrade
# SQLAlchemy async engine pool tuning (db/session.py) — optional, sane
# defaults if unset.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=False

# ── Cache / Message Broker (Phase 3/4) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Feature Store — PostgreSQL offline store / Redis online store ────────────
# The single physical PostgreSQL database every package that persists
# data shares (Feature Store, Decision Engine, Learning, Portfolio,
# Watchlist, Users, Paper Trading, Dashboard) — required by
# docker-compose.yml's `postgres`/`api` services.
FEATURE_STORE_POSTGRES_HOST=localhost
FEATURE_STORE_POSTGRES_PORT=5432
FEATURE_STORE_POSTGRES_DB=optitrade
FEATURE_STORE_POSTGRES_USER=optitrade_user
FEATURE_STORE_POSTGRES_PASSWORD=
# Online-store Redis (packages needing a different Redis can override
# with <PACKAGE>_REDIS_HOST/PORT/DB — see core/infra_config.py).
FEATURE_STORE_REDIS_HOST=localhost
FEATURE_STORE_REDIS_PORT=6379
FEATURE_STORE_REDIS_DB=0
# Connection hardening (core/infra_config.py) — optional, sane defaults
# if unset.
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5

# ── Users Platform — JWT/security ─────────────────────────────────────────────
# HMAC signing secret for access/refresh tokens (users/config.py). If
# unset, a random secret is generated per-process — fine for a single
# dev instance, but every worker/replica in production MUST share the
# same value, or issued tokens won't validate across them.
# REQUIRED (startup fails otherwise) when ENVIRONMENT=production above -
# must be at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
USERS_JWT_SECRET=

# ── LLM Provider (in active use — see explanation_engine/, core/*_persona.py)
# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Requests per minute for the /analyze endpoint (default: 30)
ANALYZE_RATE_LIMIT=30

# ── Workers ───────────────────────────────────────────────────────────────────
# Number of uvicorn worker processes (set to 1 in development)
UVICORN_WORKERS=2

# ── Market Data Provider ──────────────────────────────────────────────────────
# HYBRID (default): BIST -> yfinance, crypto -> Binance (free, no key),
#   US -> Finnhub if FINNHUB_API_KEY is set, else yfinance.
# YFINANCE: force yfinance for everything (old behavior).
MARKET_DATA_PROVIDER=HYBRID
